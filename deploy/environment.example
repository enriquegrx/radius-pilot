# Required: stable signing key for browser sessions.
RADIUS_ADMIN_SESSION_SECRET=replace-with-at-least-32-random-bytes
RADIUS_ADMIN_SECURE_COOKIE=1
RADIUS_ADMIN_PUBLIC_URL=https://radius.your-domain.com
RADIUS_ADMIN_ALLOWED_HOSTS=radius.your-domain.com,127.0.0.1,localhost
RADIUS_ADMIN_ORGANIZATION=Your Organization
RADIUS_ADMIN_AUTHORIZE_PATH=/etc/freeradius/3.0/mods-config/files/vpn-users/authorize

# Restrict custom rules to destinations owned by this VPN. Downloadable ACLs
# stay disabled until the exact IOS XE platform has passed a real deny test and
# Duo's [radius_client] forwards Cisco-AVPair.
RADIUS_ADMIN_POLICY_DESTINATIONS=192.0.2.0/24,198.51.100.0/24
RADIUS_ADMIN_CUSTOM_DACL_ENABLED=0
# Never assign Custom access to these router-local break-glass usernames: a
# RADIUS outage would authenticate them locally without downloaded attributes.
RADIUS_ADMIN_LOCAL_FALLBACK_USERS=router-break-glass

# Optional SMTP delivery for one-time invitations. Without this block, the
# panel displays each invitation once so an administrator can copy it.
RADIUS_ADMIN_SMTP_HOST=smtp.your-domain.com
RADIUS_ADMIN_SMTP_PORT=587
RADIUS_ADMIN_SMTP_STARTTLS=1
RADIUS_ADMIN_SMTP_USERNAME=radiuspilot@your-domain.com
RADIUS_ADMIN_SMTP_PASSWORD=replace-with-an-app-password
RADIUS_ADMIN_SMTP_FROM=RadiusPilot <radiuspilot@your-domain.com>

# Optional. With SMTP configured, the reconciler emails this address a digest
# of accounts expiring within the warning window (each account once), and an
# alert when the authentication service degrades — a service down, an invalid
# configuration, the certificate within the warning window, or low disk — plus
# a recovery message when it clears. Alerts are sent once per state change.
RADIUS_ADMIN_ADMIN_EMAIL=vpn-admins@your-domain.com
RADIUS_ADMIN_EXPIRY_WARNING_DAYS=7
RADIUS_ADMIN_CERT_WARNING_DAYS=21

# Optional. When RADIUS accounting is enabled, a session is considered online
# while its latest accounting record is newer than this many seconds, so a lost
# Stop packet cannot pin a user online forever. Set above the gateway's interim
# accounting interval.
RADIUS_ADMIN_ACCT_STALE_SECONDS=1800

# Optional. Enables the "Disconnect" button, which asks the gateway to drop a
# user's live session via RADIUS CoA (Disconnect-Request). Point TARGET at the
# gateway's dynamic-author listener and use the same key configured there.
RADIUS_ADMIN_COA_TARGET=172.26.200.1:1700
RADIUS_ADMIN_COA_SECRET=replace-with-a-strong-shared-secret

# Optional. The Overview map and the /wall display place each live session by
# its client IP. Set the gateway's own coordinates and label for the map's home
# marker (defaults to Granada). Point GEOIP_CSV at a CSV to resolve any public
# IP (columns: network,latitude,longitude,country_iso,country_name,city — e.g.
# exported from MaxMind GeoLite2); without it, only well-known ranges resolve and
# the rest are reported as "unlocated". Private/LAN clients are never plotted.
RADIUS_ADMIN_SITE_LAT=37.1773
RADIUS_ADMIN_SITE_LON=-3.5986
RADIUS_ADMIN_SITE_LABEL=Gateway
# RADIUS_ADMIN_GEOIP_CSV=/etc/radius-user-admin/geoip.csv
# For country-based access enforcement (geo-fencing), point this at a GeoLite2
# Country .mmdb (install python3-maxminddb). It gives fast, worldwide IP-to-
# country resolution for the per-authentication hook; without it only well-known
# ranges resolve and everything else is treated as unlocated (allowed under
# fail-open). Set the same variable in the FreeRADIUS service environment so the
# geo-check hook can read it.
# RADIUS_ADMIN_GEOIP_MMDB=/etc/radius-user-admin/GeoLite2-Country.mmdb
